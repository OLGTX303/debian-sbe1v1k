+/* SBE1V1K QSDK14 NSS-DP/EDMA host configuration, ported from IPQ9574 RDP DTS. */
+&soc {
+	/*
+	 * Only PPE ports 3-6 are wired on this board (see qcom,port_phyinfo
+	 * under &ess_switch). dp1/dp2 used to be declared here, which created
+	 * eth0/eth1 with nothing behind them - the driver logged
+	 * "No PPE port 1 node found" / "Phylink setup failed" and left two
+	 * dead netdevs in the interface list. They are intentionally omitted,
+	 * so the netdevs now line up one-to-one with the four physical ports:
+	 *
+	 *   eth0 - dp3 - QCA8075 phy 18 (1G)
+	 *   eth1 - dp4 - QCA8075 phy 19 (1G)
+	 *   eth2 - dp5 - QCA8081 phy 28 (2.5G)
+	 *   eth3 - dp6 - RTL8261N phy 0  (10G, WAN)
